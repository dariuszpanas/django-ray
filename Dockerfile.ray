# Ray Worker Image with django-ray installed
# This image is used for Ray head and workers so they can execute django-ray tasks
#
# Build: docker build -f Dockerfile.ray -t django-ray-worker:latest .

ARG RAY_VERSION=2.60.0
ARG PYTHON_VERSION=py312

FROM rayproject/ray:${RAY_VERSION}-${PYTHON_VERSION}

ARG RAY_VERSION

USER root

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /usr/local/bin/uv

WORKDIR /app

# Copy dependency lockfile and project metadata
COPY pyproject.toml uv.lock ./

# Copy source code
COPY src/ src/
COPY testproject/ testproject/
COPY README.md ./

# Install locked, hash-verified dependencies from uv.lock and install django-ray
# without allowing unpinned resolution, keeping application code read-only to ray.
RUN uv export --frozen --no-dev --extra postgres --extra sample --no-emit-project \
        --format requirements-txt -o /tmp/requirements.txt && \
    uv pip install --system --no-deps --require-hashes --no-cache-dir -r /tmp/requirements.txt && \
    uv pip install --system --no-deps --no-cache-dir . && \
    rm -f /tmp/requirements.txt && \
    chown -R root:root /app/src /app/testproject && \
    chmod -R a-w /app/src /app/testproject

USER ray

# Set environment variables
ENV DJANGO_SETTINGS_MODULE=testproject.settings \
    PYTHONPATH=/app/src:/app

# Verify installation
RUN python -c "import django_ray; import psycopg; import ninja; import gunicorn; print('django-ray and dependencies installed successfully')"
